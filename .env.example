# Sentry — projeto `devdex`. Sem PUBLIC_SENTRY_DSN o SDK não entra no bundle.
# Onde: Vercel (Production e Preview). SENTRY_AUTH_TOKEN e SENTRY_ORG também no
# build da Vercel, para enviar source maps. Não são secret de runtime do site.
PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=devdex

# PostHog — projeto único compartilhado (US). Sem a chave o analytics não inicia.
# Onde: Vercel (Production e Preview). A chave é pública de projeto, mesmo assim
# não entra no git.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
